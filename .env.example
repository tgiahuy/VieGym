# VieGym local environment template
# Copy this file to .env and replace every replace_me_before_running value.
# Never commit .env or real credentials.

# Runtime
SPRING_PROFILES_ACTIVE=local
APP_ENV=local
LOG_LEVEL=INFO
LOG_STRUCTURED_FORMAT=logstash
APP_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# Backend
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=

# PostgreSQL
POSTGRES_DB=viegym
POSTGRES_USER=viegym_app
POSTGRES_PASSWORD=replace_me_before_running
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/viegym
SPRING_DATASOURCE_USERNAME=viegym_app
SPRING_DATASOURCE_PASSWORD=replace_me_before_running
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=3000

# Authentication and scheduling
JWT_SIGNING_KEY=replace_me_before_running
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D
OTP_TTL=PT10M
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=PT1M
SCHEDULE_MISSED_GRACE=PT1H
GOOGLE_CLIENT_ID=

# OTP email. Use MAIL_PROVIDER=email with a Gmail App Password for real delivery.
# Keep MAIL_PROVIDER=fake in automated tests.
MAIL_PROVIDER=fake
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=replace_with_your_16_character_gmail_app_password
MAIL_FROM_ADDRESS=your-account@gmail.com

# AI Service
AI_SERVICE_BASE_URL=http://ai-service:8000
AI_SERVICE_TOKEN=replace_me_before_running
AI_PROVIDER=mock
AI_MODEL=mock
AI_PROVIDER_API_KEY=unused_for_mock
AI_CONNECT_TIMEOUT_SECONDS=3
AI_READ_TIMEOUT_SECONDS=20
AI_MAX_ATTEMPTS=2
AI_MAX_CONTEXT_BYTES=32768
AI_MAX_OUTPUT_TOKENS=1024
AI_LOG_LEVEL=INFO

# MinIO / S3-compatible storage
MINIO_ROOT_USER=viegym_local
MINIO_ROOT_PASSWORD=replace_me_before_running
STORAGE_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=viegym-media
STORAGE_ACCESS_KEY=viegym_local
STORAGE_SECRET_KEY=replace_me_before_running
STORAGE_REGION=us-east-1
STORAGE_PATH_STYLE_ACCESS=true
STORAGE_UPLOAD_TTL=PT5M
STORAGE_ACCESS_TTL=PT5M

# Upload policy
MEDIA_MAX_IMAGE_BYTES=5242880
MEDIA_MAX_EXERCISE_VIDEO_BYTES=52428800

# Mobile configuration is public; never place server credentials here.
MOBILE_API_BASE_URL=http://10.0.2.2:8080
