          }
        }
      },
      "Metrics": {
        "type": "object",
        "properties": {
          "bmi": {
            "type": "number"
          },
          "bmrKcal": {
            "type": "number"
          },
          "tdeeKcal": {
            "type": "number"
          }
        }
      },
