              "$ref": "#/components/schemas/EquipmentItem"
            }
          },
          "equipmentOnboardingCompletedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateHealthProfileRequest": {
        "type": "object",
        "properties": {
          "dateOfBirth": {
            "type": "string",
            "format": "date"
          },
          "gender": {
            "type": "string",
            "enum": [
              "MALE",
              "FEMALE",
              "OTHER",
              "UNSPECIFIED"
            ]
          },
          "calculationSex": {
            "type": "string",
            "enum": [
              "MALE",
              "FEMALE",
              "UNSPECIFIED"
            ]
          },
          "heightCm": {
            "type": "number",
            "maximum": 999.99,
            "minimum": 0.01
          },
          "currentWeightKg": {
            "type": "number",
            "maximum": 9999.99,
            "minimum": 0.01
          },
          "activityLevel": {
            "type": "string",
            "enum": [
              "SEDENTARY",
              "LIGHT",
              "MODERATE",
              "ACTIVE",
              "VERY_ACTIVE"
            ]
          },
          "fitnessGoal": {
            "type": "string",
            "enum": [
              "LOSE_WEIGHT",
              "MAINTAIN_WEIGHT",
              "GAIN_WEIGHT",
              "GAIN_MUSCLE"
            ]
          },
          "trainingExperience": {
            "type": "string",
            "enum": [
              "BEGINNER",
              "INTERMEDIATE",
              "ADVANCED"
            ]
          }
        },
        "required": [
          "activityLevel",
          "currentWeightKg",
          "dateOfBirth",
          "fitnessGoal",
          "gender",
          "heightCm",
          "trainingExperience"
        ]
      },
      "ApiResponseHealthProfileResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "data": {
