          },
          "gender": {
            "type": "string",
            "enum": [
              "MALE",
              "FEMALE",
              "OTHER",
              "UNSPECIFIED"
            ]
          },
          "calculationSex": {
            "type": "string",
            "enum": [
              "MALE",
              "FEMALE",
              "UNSPECIFIED"
            ]
          },
          "heightCm": {
            "type": "number"
          },
          "currentWeightKg": {
            "type": "number"
          },
          "activityLevel": {
            "type": "string",
            "enum": [
              "SEDENTARY",
              "LIGHT",
              "MODERATE",
              "ACTIVE",
              "VERY_ACTIVE"
            ]
          },
          "fitnessGoal": {
            "type": "string",
            "enum": [
              "LOSE_WEIGHT",
              "MAINTAIN_WEIGHT",
              "GAIN_WEIGHT",
              "GAIN_MUSCLE"
